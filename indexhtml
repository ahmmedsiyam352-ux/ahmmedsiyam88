</header>

<section class="hero" id="home">
    <div class="badge">✦ WELCOME TO STARX</div>

    <h1>Build Your<br><span>Digital World.</span></h1>

    <p>
        Discover a modern digital experience with a beautiful design,
        smooth animations and a layout made for every device.
    </p>

    <div class="buttons">
        <a href="#features" class="btn primary">Explore More ↗</a>
        <a href="#about" class="btn secondary">About Us</a>
    </div>
</section>

<section class="features" id="features">

    <div class="card">
        <div class="icon">⚡</div>
        <h2>Fast Experience</h2>
        <p>A lightweight design that loads quickly and works smoothly on mobile devices.</p>
    </div>

    <div class="card">
        <div class="icon">🎨</div>
        <h2>Modern Design</h2>
        <p>A premium dark theme with elegant colors and a clean interface.</p>
    </div>

    <div class="card">
        <div class="icon">📱</div>
        <h2>Mobile Friendly</h2>
        <p>A responsive layout that adapts to different screen sizes.</p>
    </div>

</section>

<footer id="about">
    © 2026 StarX. All Rights Reserved.
</footer>

</body>
</html>
